PORT=3000
JWT_SECRET=sua_chave_secreta_aqui
CODIGO_ENTRADA_SECRET=saint-scale-codigo-entrada-secreto

# Ambiente de execucao: development | production | test
NODE_ENV=development

# Origem permitida para requisicoes CORS (ex.: "http://localhost:8082" para dev local)
CORS_ORIGIN=http://localhost:8082

# ── MySQL (WAMP / XAMPP — configuração padrão local) ───────────────────────
# WAMP/XAMPP padrão: root sem senha, porta 3306
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=saintscale_dev

# ── Alternativa: usuário dedicado (opcional, mais seguro) ──────────────────
# Se preferir criar um usuário dedicado no phpMyAdmin:
#   DB_USER=saintscale
#   DB_PASSWORD=saintscale123

# ── Igreja padrão para cadastro de usuários (desenvolvimento/teste) ────────
# Se não informado, o backend usa "Igreja Central" e a cria automaticamente.
# DEFAULT_IGREJA_ID=1
# DEFAULT_IGREJA_NOME=Igreja Central

# ── Frontend (saint-scale/) ────────────────────────────────────────────────
# Lida pelo Expo no frontend — NÃO pelo backend.
# EXPO_PUBLIC_API_URL=http://localhost:3000/api
