PORT=3000
JWT_SECRET=sua_chave_secreta_aqui

# Ambiente de execucao: development | production | test
NODE_ENV=development

# Origem permitida para requisicoes CORS (ex.: "http://localhost:8081" para dev local)
CORS_ORIGIN=http://localhost:8081

# ── MySQL (WAMP / MySQL Server local) ──────────────────────────
# Configure com as credenciais do seu MySQL local
DB_HOST=127.0.0.1
DB_PORT=3308
DB_USER=saintscale
DB_PASSWORD=sua_senha_aqui
DB_NAME=saintscale_dev

# Igreja padrão de teste para cadastro de usuários (desenvolvimento/teste).
# Se não informado, o backend usa "Igreja Central" e a cria de forma idempotente.
# DEFAULT_IGREJA_ID=1
# DEFAULT_IGREJA_NOME=Igreja Central

# ──────────────────────────────────────────────────────────────────────────────
# Configuração do frontend (saint-scale/)
# A variável abaixo é lida pelo Expo no frontend e NÃO pelo backend.
# EXPO_PUBLIC_API_URL=http://localhost:3000/api
# ──────────────────────────────────────────────────────────────────────────────
